DATABASE_PATH=data/calendar.db
SECRET_KEY=change-me-before-production
FLASK_DEBUG=1

# טוקן של בוט הטלגרם. ה-worker קורא רק את המשתנה הזה, לא את BOT_TOKEN.
# אל תכניסו לגיט ערך אמיתי.
TELEGRAM_BOT_TOKEN=
# אזור זמן לאירוע בלי שעה, ולחישוב מועד התזכורת
REMINDER_TIMEZONE=Asia/Jerusalem
# שעה מקומית כשאין שדה time באירוע
REMINDER_DEFAULT_TIME=09:00
# שניות בין סבבי ה-worker (30–60)
REMINDER_POLL_SECONDS=45

# שמור לאינטגרציה עתידית. worker התזכורות לא משתמש בו.
BOT_TOKEN=
