DATABASE_PATH=data/calendar.db
SECRET_KEY=change-me-before-production
FLASK_DEBUG=1

# טוקן של בוט הטלגרם. ה-worker קורא רק את המשתנה הזה, לא את BOT_TOKEN.
# אל תכניסו לגיט ערך אמיתי.
TELEGRAM_BOT_TOKEN=
# אזור זמן לאירוע בלי שעה, ולחישוב מועד התזכורת
REMINDER_TIMEZONE=Asia/Jerusalem
# שעה מקומית כשאין שדה time באירוע
REMINDER_DEFAULT_TIME=09:00
# שניות בין סבבי ה-worker (30–60)
REMINDER_POLL_SECONDS=45
# סיכום בוקר בטלגרם (אופציונלי, כבוי עד שמפעילים בבוט לאדם מחובר).
# כל יום א׳–ו׳ בשעה הזו לפי REMINDER_TIMEZONE. לא נשלח בשבת.
# בשישי ההודעה כוללת גם את אירועי שבת.
DIGEST_HOUR=6
DIGEST_MINUTE=0
# שניות בין סנכרוני יומן גוגל (ברירת מחדל 900 = רבע שעה)
GCAL_SYNC_SECONDS=900
# כמה ימים אחורה וקדימה נמשכים מהיומן
GCAL_SYNC_PAST_DAYS=180
GCAL_SYNC_FUTURE_DAYS=400

# שמור לאינטגרציה עתידית. worker התזכורות לא משתמש בו.
BOT_TOKEN=

# עדכון גרסה מההגדרות. מי שכבר בלוח יכול לבדוק ולעדכן (יש CSRF).
# פקודה קבועה להפעלה מחדש בלי Docker. לא מגיעה מהדפדפן.
# נתיב יחסי לשורש הפרויקט, או נתיב מלא. הסקריפט בריפו: scripts/restart.sh
# כתובת ופורט: HEB_CAL_BIND_HOST / HEB_CAL_PORT (ברירת מחדל 127.0.0.1:5000).
# הסקריפט צריך לצאת אחרי ההפעלה, ולעצור בלבד כש-HEB_CAL_UPDATE_ACTION=stop.
# בתוך Docker לא משתמשים בזה. העדכון שם הוא:
#   docker compose pull && docker compose up -d
# (הקומפוז קובע HEB_CAL_UPDATE_MODE=docker; auto מזהה גם /.dockerenv).
HEB_CAL_RESTART_COMMAND=
# auto (ברירת מחדל) / git / docker / hook / off
HEB_CAL_UPDATE_MODE=auto
# owner/name. ריק = המאגר של origin, ואם אין — pilpel1/HEB-CAL
HEB_CAL_GITHUB_REPO=
# רק למאגר פרטי. לא לשים בקוד, ולא נכתב ללוג.
HEB_CAL_GITHUB_TOKEN=
# נתיב מלא לסקריפט עדכון (מצב hook, או Docker עם כפתור). בלי רווחים.
HEB_CAL_UPDATE_HOOK=
# בדיקת גרסה פעם ביום. 0 מכבה. הנקודה על גלגל השיניים נשארת לפי הבדיקה האחרונה.
HEB_CAL_UPDATE_AUTOCHECK=1
# בדיקה שהאפליקציה עלתה. רק localhost.
HEB_CAL_HEALTH_URL=http://127.0.0.1:5000/api/updates/health
# HEB_CAL_BACKUP_DIR=backups
# HEB_CAL_DOCKER=1

# --- Docker (נקרא ע"י docker compose, לא ע"י פייתון) ---
# BOT_TOKEN למעלה לא בשימוש. הטוקן החי הוא TELEGRAM_BOT_TOKEN.
# SECRET_KEY חובה להחליף לפני עלייה. הערך מהדוגמה נחסם בקונטיינר.
# FLASK_DEBUG=1 הוא לפיתוח מקומי. ב-Docker הקומפוז כופה 0.
#
# על איזה ממשק של המארח לפרסם את פורט 5000 של הקונטיינר.
# 127.0.0.1 = רק מהמחשב הזה. אין פורט פתוח לרשת; Tailscale על המארח מגיע לפה.
# 0.0.0.0 פותח את הפורט לכל הרשת המקומית.
HEB_CAL_BIND_HOST=127.0.0.1
# פורט על המארח. בתוך הקונטיינר האפליקציה תמיד על 5000.
HEB_CAL_PORT=5000
# אופציונלי. ברירת מחדל: ghcr.io/pilpel1/heb-cal:latest
# HEB_CAL_IMAGE=ghcr.io/pilpel1/heb-cal:latest
